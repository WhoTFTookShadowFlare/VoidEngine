[submodule "extern/glbinding"]
	path = components/graphics/opengl/glbinding
	url = https://github.com/cginternals/glbinding
[submodule "extern/stb"]
	path = libs/stb
	url = https://github.com/nothings/stb
[submodule "extern/glm"]
	path = libs/glm
	url = https://github.com/g-truc/glm
[submodule "extern/assimp"]
	path = libs/assimp
	url = https://github.com/assimp/assimp
[submodule "extern/openal"]
	path = components/audio/openal/openal
	url = https://github.com/kcat/openal-soft
[submodule "extern/toml++"]
	path = libs/toml++
	url = https://github.com/marzer/tomlplusplus
[submodule "libs/SDL3"]
	path = libs/SDL3
	url = https://github.com/libsdl-org/sdl
[submodule "components/scripts/lua/lua"]
	path = components/scripts/lua/lua
	url = https://github.com/lua/lua
